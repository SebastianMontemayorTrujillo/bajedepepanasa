{
  "name": "bajedepepanasa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vals del Agua — Monterrey flood & surface-water explorer for NASA Space Apps 2026",
  "scripts": {
    "dev": "concurrently -k -n web,catalog -c teal,yellow \"vite\" \"tsx server/catalogProxy.ts\"",
    "dev:web": "vite",
    "dev:catalog": "tsx server/catalogProxy.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "agent:validate": "cd sar-guide && npx --yes @grok/agent-sdk@0.6.0 validate",
    "agent:serve": "cd sar-guide && npx --yes @grok/agent-sdk@0.6.0 serve",
    "agent:stub": "tsx server/catalogProxy.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
